<Window x:Class="FileMill.MainWindow"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"

        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"

        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"

        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"

        xmlns:models="clr-namespace:FileMill.Models"

        xmlns:conv="clr-namespace:FileMill.Converters"

        xmlns:views="clr-namespace:FileMill.Views"

        mc:Ignorable="d"

        Title="FileMill"

        Icon="app.ico"

        Height="{Binding WindowHeight, Mode=TwoWay}" Width="{Binding WindowWidth, Mode=TwoWay}"

        Left="{Binding WindowLeft, Mode=TwoWay}" Top="{Binding WindowTop, Mode=TwoWay}"

        WindowState="{Binding WindowState, Mode=TwoWay}"

        MinHeight="600" MinWidth="850"

        WindowStartupLocation="CenterScreen"

        Background="{DynamicResource WindowBackground}">



    <Window.Resources>

        <!-- 組み込みのBooleanToVisibilityConverter -->

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        

        <!-- 文字列比較用コンバーター -->

        <conv:StringEqualsToVisibilityConverter x:Key="ModalTypeToVis"/>

        

        <!-- EnumToBooleanConverter -->

        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>



        <!-- ダイアログ用シャドウ効果 -->

        <DropShadowEffect x:Key="DialogShadow" BlurRadius="15" Color="Black" Opacity="0.3" ShadowDepth="4" Direction="270"/>

        

        <!-- ポップアップカードのスタイル -->

        <Style x:Key="PopupCardStyle" TargetType="Border">

            <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>

            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>

            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="CornerRadius" Value="6"/>

            <Setter Property="Padding" Value="12"/>

            <Setter Property="Effect">

                <Setter.Value>

                    <DropShadowEffect BlurRadius="12" Color="Black" Opacity="0.15" ShadowDepth="3" Direction="270"/>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- 歯車ボタンのスタイル -->

        <Style x:Key="GearButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="24"/>

            <Setter Property="Height" Value="24"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Content" Value="⚙"/>

            <Setter Property="FontSize" Value="14"/>

            <Setter Property="Foreground" Value="{DynamicResource GearButtonForeground}"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolbarButtonHoverBackground}"/>

                                <Setter Property="Foreground" Value="{DynamicResource GearButtonHoverForeground}"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource GearButtonPressedBackground}"/>

                                <Setter Property="Foreground" Value="{DynamicResource GearButtonPressedForeground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- ツールバーボタンのスタイル -->

        <Style x:Key="ToolbarButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="32"/>

            <Setter Property="Height" Value="32"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="4">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolbarButtonHoverBackground}"/>

                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolbarButtonPressedBackground}"/>

                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">

                                <Setter Property="Opacity" Value="0.4"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>



        <!-- 丸いアイコンボタンのスタイル -->

        <Style x:Key="IconButtonStyle" TargetType="Button">

            <Setter Property="Width" Value="20"/>

            <Setter Property="Height" Value="20"/>

            <Setter Property="Background" Value="Transparent"/>

            <Setter Property="BorderThickness" Value="0"/>

            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">

                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="border" Background="{TemplateBinding Background}" CornerRadius="10">

                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" Value="True">

                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ToolbarButtonHoverBackground}"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>

            </Setter>

        </Style>

    </Window.Resources>



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0">



        <!-- ===== MENU BAR ===== -->

        <Menu DockPanel.Dock="Top" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">

            <MenuItem Header="ファイル(_F)">

                <MenuItem Header="画像を追加(_A)..." Command="{Binding AddFilesCommand}"/>

                <MenuItem Header="フォルダを追加(_D)..." Command="{Binding AddFolderCommand}"/>

                <Separator/>

                <MenuItem Header="出力先を選択(_O)..." Command="{Binding BrowseOutputCommand}"/>

                <Separator/>

                <MenuItem Header="終了(_X)" Click="MenuItem_Exit_Click"/>

            </MenuItem>

            <MenuItem Header="リスト(_L)">

                <MenuItem Header="すべてクリア(_C)" Command="{Binding ClearFilesCommand}"/>

                <MenuItem Header="選択したファイルを削除(_R)" Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileListView}"/>

            </MenuItem>

            <MenuItem Header="設定(_S)">

                <MenuItem Header="オプション(_O)..." Command="{Binding DataContext.OpenModalCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="Options"/>

            </MenuItem>

            <MenuItem Header="変換(_C)">

                <MenuItem Header="変換開始(_S)" Command="{Binding ProcessCommand}"/>

            </MenuItem>

            <MenuItem Header="ヘルプ(_H)">

                <MenuItem Header="バージョン情報(_A)" Click="MenuItem_About_Click"/>

            </MenuItem>

        </Menu>



        <!-- ===== TABS ===== -->

        <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}" BorderThickness="0" Background="Transparent" Padding="0" Margin="0,2,0,0">

            <TabItem Header="画像変換" FontSize="13" Padding="16,6">

                <DockPanel>

                    <!-- ===== TOOLBAR ===== -->

                    <StackPanel DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}">

                        <!-- ツールバー（1行統合） -->

                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,4">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="120"/>

                                </Grid.ColumnDefinitions>



                                <!-- 左側ボタン群 -->

                                <StackPanel Orientation="Horizontal" Grid.Column="0">

                                    <Button Command="{Binding AddFilesCommand}" ToolTip="画像を追加" Style="{StaticResource ToolbarButtonStyle}">

                                        <TextBlock Text="📁＋" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding AddFolderCommand}" ToolTip="フォルダを追加" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="📂＋" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding ClearFilesCommand}" ToolTip="すべて削除" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="🗑" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding RemoveFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=FileListView}" ToolTip="選択したファイルを削除" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="❌" FontSize="14"/>

                                    </Button>

                                </StackPanel>



                                <!-- 中央：出力先 -->

                                <Grid Grid.Column="1" Margin="16,0" MaxWidth="560">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="出力先" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ControlForegroundDim}" FontSize="12"/>

                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" FontSize="11" Padding="4,0"/>

                                    <Button Grid.Column="2" Content="..." Width="28" Height="24" Margin="4,0,0,0" Command="{Binding BrowseOutputCommand}"/>

                                </Grid>



                                <!-- 右側：変換実行ボタン -->

                                <Button Grid.Column="2" Command="{Binding ProcessCommand}" ToolTip="変換開始" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Width="100" Height="28" HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="▶" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="変換" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </StackPanel>







        <!-- ===== MAIN CONTENT ===== -->

        <Grid Margin="8">

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="4"/> <!-- GridSplitter -->

                <ColumnDefinition Width="240" MinWidth="200" MaxWidth="400"/> <!-- 右側サイドバー -->

            </Grid.ColumnDefinitions>



            <!-- 左側：ファイルリスト -->

            <GroupBox Grid.Column="0" Header="画像ファイルリスト" Padding="4">

                <Border x:Name="FileListDropBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource ControlBackground}"

                        AllowDrop="True" DragEnter="FileList_DragEnter" DragOver="FileList_DragOver" DragLeave="FileList_DragLeave" Drop="FileList_Drop">

                    <Grid>

                        <!-- プレースホルダー -->

                        <TextBlock Text="ここに画像ファイルまたはフォルダをドラッグ＆ドロップしてください"

                                   FontSize="13" Foreground="{DynamicResource ControlForegroundDim}" HorizontalAlignment="Center" VerticalAlignment="Center">

                            <TextBlock.Style>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Visibility" Value="Collapsed"/>

                                    <Style.Triggers>

                                        <DataTrigger Binding="{Binding IsFileListEmpty}" Value="True">

                                            <Setter Property="Visibility" Value="Visible"/>

                                        </DataTrigger>

                                    </Style.Triggers>

                                </Style>

                            </TextBlock.Style>

                        </TextBlock>



                        <!-- リストビュー -->

                        <ListView x:Name="FileListView" ItemsSource="{Binding Files}" BorderThickness="0" SelectionMode="Extended">

                            <ListView.Resources>

                                <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
                                    <EventSetter Event="Click" Handler="FileListHeader_Click"/>
                                </Style>

                            </ListView.Resources>

                            <ListView.View>

                                <GridView>

                                    <!-- チェックボックス列（全選択チェックボックスはヘッダーに配置） -->

                                    <GridViewColumn Width="40">

                                        <GridViewColumnHeader>

                                            <CheckBox x:Name="HeaderAllCheck" Checked="HeaderAllCheck_Checked" Unchecked="HeaderAllCheck_Unchecked" HorizontalAlignment="Center"/>

                                        </GridViewColumnHeader>

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColName" Header="名前" Width="180">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColDim" Header="大きさ" Width="90">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding DimensionsDisplay}" HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColSize" Header="サイズ" Width="80">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding FileSizeDisplay}" HorizontalAlignment="Right"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColFormat" Header="種類" Width="60">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding Format}" HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColDateModified" Header="更新日時" Width="110">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding DateModifiedDisplay}" HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColDateTaken" Header="写真の撮影日" Width="110">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding DateTakenDisplay}" HorizontalAlignment="Center"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>



                                    <GridViewColumn x:Name="ColPath" Header="パス" Width="200">

                                        <GridViewColumn.CellTemplate>

                                            <DataTemplate>

                                                <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>

                                            </DataTemplate>

                                        </GridViewColumn.CellTemplate>

                                    </GridViewColumn>

                                </GridView>

                            </ListView.View>



                            <ListView.ItemContainerStyle>

                                <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">

                                    <Setter Property="ContextMenu">

                                        <Setter.Value>

                                            <ContextMenu>

                                                <MenuItem Header="削除(_D)" Command="{Binding DataContext.RemoveFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>

                                            </ContextMenu>

                                        </Setter.Value>

                                    </Setter>

                                </Style>

                            </ListView.ItemContainerStyle>

                        </ListView>

                    </Grid>

                </Border>

            </GroupBox>



            <!-- Splitter -->

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>



            <!-- 右側：サイドバー -->

            <GroupBox Grid.Column="2" Header="処理オプション" Padding="4">

                <ScrollViewer VerticalScrollBarVisibility="Auto">

                    <StackPanel Margin="2">

                        <!-- 1. Exif自動回転 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid MinHeight="24">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="Exif自動回転" IsChecked="{Binding ExifAutoRotateStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Visibility="Collapsed"/>

                            </Grid>

                        </Border>



                        
<!-- 2. トリミング -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="トリミング" IsChecked="{Binding CropStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Crop"/>

                            </Grid>

                        </Border>



                        
<!-- 3. 回転 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="回転" IsChecked="{Binding RotateStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Rotate"/>

                            </Grid>

                        </Border>



                        
<!-- 4. リサイズ -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="リサイズ" IsChecked="{Binding ResizeStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Resize"/>

                            </Grid>

                        </Border>



                        
<!-- 5. 余白の追加 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="余白の追加" IsChecked="{Binding PaddingStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Padding"/>

                            </Grid>

                        </Border>



                        
<!-- 6. グレースケール化 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid MinHeight="24">

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="グレースケール化" IsChecked="{Binding GrayscaleStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Visibility="Collapsed"/>

                            </Grid>

                        </Border>



                        
<!-- 7. アンシャープマスク -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="アンシャープマスク" IsChecked="{Binding SharpenStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Sharpen"/>

                            </Grid>

                        </Border>



                        
<!-- 8. 色調補正 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="色調補正" IsChecked="{Binding ColorAdjustStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="ColorAdjust"/>

                            </Grid>

                        </Border>



                        
<!-- 9. トーンカーブ -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="トーンカーブ" IsChecked="{Binding ToneCurveStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="ToneCurve"/>

                            </Grid>

                        </Border>



                        
<!-- 10. 減色 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="減色" IsChecked="{Binding PosterizeStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Posterize"/>

                            </Grid>

                        </Border>



                        
<!-- 11. 画像合成 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="画像合成" IsChecked="{Binding CompositeStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Composite"/>

                            </Grid>

                        </Border>

                    
<!-- 12. フォーマット変換 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="フォーマット変換" IsChecked="{Binding FormatStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Format"/>

                            </Grid>

                        </Border>



                        
<!-- 13. 最適化 -->

                        <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="Auto"/>

                                </Grid.ColumnDefinitions>

                                <CheckBox Content="最適化" IsChecked="{Binding OptimizeStep.Enabled, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="Optimize"/>

                            </Grid>

                        </Border>



                        </StackPanel>

                </ScrollViewer>

            </GroupBox>

        </Grid>

                </DockPanel>

            </TabItem>

            

            <TabItem Header="ファイル最適化" FontSize="13" Padding="16,6">

                <DockPanel>

                    <!-- ===== TOOLBAR ===== -->

                    <StackPanel DockPanel.Dock="Top" Background="{DynamicResource ToolbarBackground}">

                        <!-- ツールバー（1行統合） -->

                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1" Padding="8,4">

                            <Grid>

                                <Grid.ColumnDefinitions>

                                    <ColumnDefinition Width="Auto"/>

                                    <ColumnDefinition Width="*"/>

                                    <ColumnDefinition Width="120"/>

                                </Grid.ColumnDefinitions>



                                <!-- 左側ボタン群 -->

                                <StackPanel Orientation="Horizontal" Grid.Column="0">

                                    <Button Command="{Binding AddOptimizeFilesCommand}" ToolTip="ファイルを追加" Style="{StaticResource ToolbarButtonStyle}">

                                        <TextBlock Text="📁＋" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding AddOptimizeFolderCommand}" ToolTip="フォルダを追加" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="📂＋" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding ClearOptimizeFilesCommand}" ToolTip="すべて削除" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="🗑" FontSize="14"/>

                                    </Button>

                                    <Button Command="{Binding RemoveOptimizeFileCommand}" CommandParameter="{Binding SelectedItem, ElementName=OptimizeFileListView}" ToolTip="選択したファイルを削除" Style="{StaticResource ToolbarButtonStyle}" Margin="6,0,0,0">

                                        <TextBlock Text="❌" FontSize="14"/>

                                    </Button>

                                </StackPanel>



                                <!-- 中央：出力先 -->

                                <Grid Grid.Column="1" Margin="16,0" MaxWidth="560">

                                    <Grid.ColumnDefinitions>

                                        <ColumnDefinition Width="Auto"/>

                                        <ColumnDefinition Width="*"/>

                                        <ColumnDefinition Width="Auto"/>

                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="出力先" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource ControlForegroundDim}" FontSize="12"/>

                                    <TextBox Grid.Column="1" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="24" VerticalContentAlignment="Center" FontSize="11" Padding="4,0"/>

                                    <Button Grid.Column="2" Content="..." Width="28" Height="24" Margin="4,0,0,0" Command="{Binding BrowseOutputCommand}"/>

                                </Grid>



                                <!-- 右側：最適化実行ボタン -->

                                <Button Grid.Column="2" Command="{Binding ProcessOptimizeCommand}" ToolTip="最適化を開始" Background="{DynamicResource AccentBackground}" BorderBrush="{DynamicResource AccentBorderBrush}" BorderThickness="1" Width="100" Height="28" HorizontalAlignment="Right">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock Text="⚡" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" Margin="0,0,4,0" VerticalAlignment="Center"/>

                                        <TextBlock Text="最適化実行" Foreground="{DynamicResource AccentForeground}" FontWeight="Bold" VerticalAlignment="Center"/>

                                    </StackPanel>

                                </Button>

                            </Grid>

                        </Border>

                    </StackPanel>



                    <!-- ===== MAIN CONTENT ===== -->

                    <Grid Margin="8">

                        <Grid.ColumnDefinitions>

                            <ColumnDefinition Width="*"/>

                            <ColumnDefinition Width="4"/>

                            <ColumnDefinition Width="260" MinWidth="220" MaxWidth="400"/>

                        </Grid.ColumnDefinitions>



                        <!-- 左側：ファイルリスト -->

                        <GroupBox Grid.Column="0" Header="最適化対象ファイルリスト" Padding="4">

                            <Border x:Name="OptimizeFileListDropBorder" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource ControlBackground}"

                                    AllowDrop="True" DragEnter="OptimizeFileList_DragEnter" DragOver="OptimizeFileList_DragOver" DragLeave="OptimizeFileList_DragLeave" Drop="OptimizeFileList_Drop">

                                <Grid>

                                    <!-- プレースホルダー -->

                                    <TextBlock Text="ここにOffice(docx, xlsx, pptx)、画像ファイル、または動画・音声ファイルをドラッグ＆ドロップしてください"

                                               FontSize="13" Foreground="{DynamicResource ControlForegroundDim}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="20">

                                        <TextBlock.Style>

                                            <Style TargetType="TextBlock">

                                                <Setter Property="Visibility" Value="Collapsed"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding IsOptimizeFileListEmpty}" Value="True">

                                                        <Setter Property="Visibility" Value="Visible"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </TextBlock.Style>

                                    </TextBlock>



                                    <!-- リストビュー -->

                                    <ListView x:Name="OptimizeFileListView" ItemsSource="{Binding OptimizeFiles}" BorderThickness="0" SelectionMode="Extended">

                                        <ListView.Resources>

                                             <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">

                                                <EventSetter Event="Click" Handler="OptimizeFileListHeader_Click"/>







                                            </Style>

                                        </ListView.Resources>

                                        <ListView.View>

                                            <GridView>

                                                <GridViewColumn Width="40">

                                                    <GridViewColumnHeader>

                                                        <CheckBox x:Name="HeaderAllCheckOptimize" Checked="HeaderAllCheckOptimize_Checked" Unchecked="HeaderAllCheckOptimize_Unchecked" HorizontalAlignment="Center"/>

                                                    </GridViewColumnHeader>

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" HorizontalAlignment="Center"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="名前" Width="180">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="種類" Width="60">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding Format}" HorizontalAlignment="Center"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="元のサイズ" Width="95">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding OriginalSizeDisplay}" HorizontalAlignment="Right"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="最適化後" Width="95">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding OptimizedSizeDisplay}" HorizontalAlignment="Right"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="削減率" Width="75">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding SavingDisplay}" HorizontalAlignment="Center" Foreground="{DynamicResource SavingsForeground}"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="状態" Width="65">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding Status}" HorizontalAlignment="Center">

                                                                <TextBlock.Style>

                                                                    <Style TargetType="TextBlock">

                                                                        <Style.Triggers>

                                                                            <DataTrigger Binding="{Binding Status}" Value="完了">

                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}"/>

                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding Status}" Value="処理中">

                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusProcessingBrush}"/>

                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding Status}" Value="エラー">

                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>

                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </TextBlock.Style>

                                                            </TextBlock>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>



                                                <GridViewColumn Header="パス" Width="200">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>

                                            </GridView>

                                        </ListView.View>



                                        <ListView.ItemContainerStyle>

                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">

                                                <Setter Property="ContextMenu">

                                                    <Setter.Value>

                                                        <ContextMenu>

                                                            <MenuItem Header="削除(_D)" Command="{Binding DataContext.RemoveOptimizeFileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>

                                                        </ContextMenu>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </ListView.ItemContainerStyle>

                                    </ListView>

                                </Grid>

                            </Border>

                        </GroupBox>



                        <!-- Splitter -->

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>



                        <!-- 右側：設定オプション（画像変換タブと統一されたスタイル） -->

                        <GroupBox Grid.Column="2" Header="最適化オプション" Padding="4">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel Margin="2">

                                    <!-- 1. Office最適化 -->

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <CheckBox Content="Office最適化" IsChecked="{Binding EnableOfficeOptimize, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="OfficeOptimize"/>

                                        </Grid>

                                    </Border>



                                    <!-- 2. 画像最適化 -->

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <CheckBox Content="画像最適化" IsChecked="{Binding EnableImageOptimize, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="ImageOptimize"/>

                                        </Grid>

                                    </Border>



                                    <!-- 3. メディア最適化 -->

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,3">

                                        <Grid>

                                            <Grid.ColumnDefinitions>

                                                <ColumnDefinition Width="*"/>

                                                <ColumnDefinition Width="Auto"/>

                                            </Grid.ColumnDefinitions>

                                            <CheckBox Content="メディア最適化" IsChecked="{Binding CompressMedia, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>

                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="MediaOptimize"/>

                                        </Grid>

                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </GroupBox>

                    </Grid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>

        <!-- デバッグコンソール (F12 でトグル) -->
        <views:DebugWindow x:Name="DebugConsole" Grid.Row="1"
                           Visibility="{Binding IsDebugVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Height="200"/>

        <!-- ===== GLOBAL STATUS BAR ===== -->
        <StatusBar Grid.Row="2" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusText}" Margin="4,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <!-- 進捗バー。処理中のみ表示 -->
                    <ProgressBar Width="120" Height="14" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Margin="0,0,12,0" 
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding OutputSummary}" Foreground="{DynamicResource ControlForegroundDim}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

</Grid>
</Window>

