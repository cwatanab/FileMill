                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding Status}" Value="処理中">

                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusProcessingBrush}"/>

                                                                            </DataTrigger>

                                                                            <DataTrigger Binding="{Binding Status}" Value="エラー">

                                                                                <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}"/>

                                                                            </DataTrigger>

                                                                        </Style.Triggers>

                                                                    </Style>

                                                                </TextBlock.Style>

                                                            </TextBlock>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>

                                                <GridViewColumn x:Name="ColPdfPath" Header="パス" Width="200">

                                                    <GridViewColumn.CellTemplate>

                                                        <DataTemplate>

                                                            <TextBlock Text="{Binding FilePath}" TextTrimming="CharacterEllipsis"/>

                                                        </DataTemplate>

                                                    </GridViewColumn.CellTemplate>

                                                </GridViewColumn>

                                            </GridView>

                                        </ListView.View>

                                        <ListView.ItemContainerStyle>

                                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">

                                                <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListView}}"/>

                                                <Setter Property="ContextMenu">

                                                    <Setter.Value>

                                                        <ContextMenu>

                                                            <MenuItem Header="削除(_D)"
                                                                      Command="{Binding PlacementTarget.Tag.RemovePdfFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                                      CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>

                                                        </ContextMenu>

                                                    </Setter.Value>

                                                </Setter>

                                            </Style>

                                        </ListView.ItemContainerStyle>

                                    </ListView>

                                </Grid>

                            </Border>

                        </GroupBox>

                        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                        <GroupBox Grid.Column="2" Header="PDF 変換オプション" Padding="4">

                            <ScrollViewer VerticalScrollBarVisibility="Auto">

                                <StackPanel Margin="2">

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="画像を最適化" IsChecked="{Binding PdfOptimizeImages, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="PdfImage" ToolTip="画像最適化の詳細設定を開く"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="ストリームを圧縮" IsChecked="{Binding PdfCompressStreams, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="PdfStream" ToolTip="ストリーム圧縮の詳細設定を開く"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="構造整理" IsChecked="{Binding PdfStructureCleanup, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="PdfStructure" ToolTip="構造整理の詳細設定を開く"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="配布・互換性" IsChecked="{Binding PdfDistributionCompatibility, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="PdfCompatibility" ToolTip="配布・互換性の詳細設定を開く"/>
                                        </Grid>
                                    </Border>

                                    <Border BorderBrush="{DynamicResource BorderBrushLight}" BorderThickness="0,0,0,1" Padding="4,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Content="制限解除" IsChecked="{Binding PdfRestrictionRemoval, Mode=TwoWay}" VerticalAlignment="Center" FontSize="12"/>
                                            <Button Grid.Column="1" Style="{StaticResource GearButtonStyle}" Command="{Binding OpenModalCommand}" CommandParameter="PdfRestrictions" ToolTip="制限解除の詳細設定を開く"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>

                            </ScrollViewer>

                        </GroupBox>

                    </Grid>

                </DockPanel>

            </TabItem>
        </TabControl>
    </DockPanel>

        <!-- デバッグコンソール (F12 でトグル) -->
        <views:DebugWindow x:Name="DebugConsole" Grid.Row="1"
                           Visibility="{Binding IsDebugVisible, Converter={StaticResource BooleanToVisibilityConverter}}"
                           Height="200"/>

        <!-- ===== GLOBAL STATUS BAR ===== -->
        <StatusBar Grid.Row="2" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource StatusBarBorderBrush}" BorderThickness="0,1,0,0" Padding="4,2">
            <StatusBarItem HorizontalAlignment="Left">
                <TextBlock Text="{Binding StatusText}" Margin="4,0"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal">
                    <!-- 進捗バー。処理中のみ表示 -->
                    <ProgressBar Width="120" Height="14" Minimum="0" Maximum="{Binding ProgressMax}" Value="{Binding ProgressValue}" Margin="0,0,12,0" 
                                 Visibility="{Binding IsProcessing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding OutputSummary}" Foreground="{DynamicResource ControlForegroundDim}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

</Grid>
</ui:FluentWindow>
