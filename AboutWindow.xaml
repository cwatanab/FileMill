<Window x:Class="FileMill.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:FileMill.Properties"
        Title="{x:Static properties:Loc.AboutTitle}"
        Width="460" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBackground}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- アプリケーション名とバージョン -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="FileMill" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ControlForeground}"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- メッセージ・謝辞スクロール領域 -->
        <Border Grid.Row="1" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" 
                           TextWrapping="Wrap" 
                           FontSize="11.5" 
                           LineHeight="18"
                           Foreground="{DynamicResource ControlForeground}"/>
            </ScrollViewer>
        </Border>

        <!-- OKボタン -->
        <Button Grid.Row="2" 
                Content="OK" 
                Width="80" 
                Height="26" 
                Margin="0,16,0,0" 
                HorizontalAlignment="Right" 
                IsDefault="True" 
                Click="OkButton_Click"/>
    </Grid>
</Window>
