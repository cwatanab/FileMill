<ui:FluentWindow x:Class="FileMill.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:properties="clr-namespace:FileMill.Properties"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="{x:Static properties:Loc.AboutTitle}"
        Width="460" Height="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="Transparent">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Icon="app.ico" />

        <Grid Grid.Row="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- アプリケーション名とバージョン -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="FileMill" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource ControlForeground}"/>
            <TextBlock x:Name="VersionText" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- メッセージ・謝辞スクロール領域 -->
        <Border Grid.Row="1" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="MessageText" 
                           TextWrapping="Wrap" 
                           FontSize="11.5" 
                           LineHeight="18"
                           Foreground="{DynamicResource ControlForeground}"/>
            </ScrollViewer>
        </Border>

        <!-- アップデートを確認ボタン & OKボタン -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button Content="アップデートを確認(_U)..." 
                    HorizontalAlignment="Left"
                    Height="28"
                    Click="CheckForUpdates_Click"/>
            <Button Content="{x:Static properties:Loc.ButtonOK}" 
                    MinWidth="80" 
                    Width="Auto"
                    Height="28" 
                    HorizontalAlignment="Right" 
                    IsDefault="True" 
                    Click="OkButton_Click"/>
        </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
