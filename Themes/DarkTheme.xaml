<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush x:Key="WindowBackground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="ControlBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="ControlForeground" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ControlForegroundDim" Color="#999999"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#333333"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#2A2A2A"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ListBackground" Color="#252525"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#333333"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="AccentBackground" Color="#1A3A1A"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#2D6A2D"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#8BC34A"/>
    <SolidColorBrush x:Key="GearButtonForeground" Color="#888888"/>
    <SolidColorBrush x:Key="GearButtonHoverBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="GearButtonHoverForeground" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="GearButtonPressedBackground" Color="#1A3A5A"/>
    <SolidColorBrush x:Key="GearButtonPressedForeground" Color="#4FC3F7"/>
    <SolidColorBrush x:Key="ToolbarButtonHoverBackground" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="ToolbarButtonPressedBackground" Color="#4A4A4A"/>
    <SolidColorBrush x:Key="SettingsBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#404040"/>
    <SolidColorBrush x:Key="TabBackground" Color="Transparent"/>

    <!-- ドラッグ＆ドロップ時のハイライト色 (ダーク) -->
    <SolidColorBrush x:Key="DragOverBackground" Color="#1A3A5A"/>
    <SolidColorBrush x:Key="DragOverBorderBrush" Color="#4FC3F7"/>

    <!-- RGBスライダーのラベル用配色 (ダーク) -->
    <SolidColorBrush x:Key="RGBRedBrush" Color="#EF5350"/>
    <SolidColorBrush x:Key="RGBGreenBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="RGBBlueBrush" Color="#64B5F6"/>

    <!-- ボタン用ホバー／プレス用オーバーレイブラシ -->
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#15FFFFFF"/>
    <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#25FFFFFF"/>

    <!-- システムカラーのオーバーライド（Menu/ComboBox等向け） -->
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#252525"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#3A3A3A"/>
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="DebugBackground" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="DebugForeground" Color="#D4D4D4"/>
    <SolidColorBrush x:Key="DebugToolbarBackground" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="DebugToolbarBorder" Color="#404040"/>

    <SolidColorBrush x:Key="SeparatorBrush" Color="#404040"/>

    <SolidColorBrush x:Key="SavingsForeground" Color="#66BB6A"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#66BB6A"/>
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="#64B5F6"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#EF5350"/>
</ResourceDictionary>
