<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- デフォルト（ライト）テーマ色 -->

    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ControlBackground" Color="White"/>
    <SolidColorBrush x:Key="ControlForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ControlForegroundDim" Color="#555555"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ListBackground" Color="White"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="AccentBackground" Color="#E2F0D9"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#A9D08E"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#385723"/>
    <SolidColorBrush x:Key="GearButtonForeground" Color="#888888"/>
    <SolidColorBrush x:Key="GearButtonHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="GearButtonHoverForeground" Color="#333333"/>
    <SolidColorBrush x:Key="GearButtonPressedBackground" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="GearButtonPressedForeground" Color="#0078D4"/>
    <SolidColorBrush x:Key="ToolbarButtonHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ToolbarButtonPressedBackground" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SettingsBackground" Color="White"/>
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="TabBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="HeaderHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="HeaderPressedBackground" Color="#D0D0D0"/>

    <!-- ドラッグ＆ドロップ時のハイライト色 -->
    <SolidColorBrush x:Key="DragOverBackground" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="DragOverBorderBrush" Color="#0078D4"/>

    <!-- RGBスライダーのラベル用配色（テーマ対応） -->
    <SolidColorBrush x:Key="RGBRedBrush" Color="#C00000"/>
    <SolidColorBrush x:Key="RGBGreenBrush" Color="#008000"/>
    <SolidColorBrush x:Key="RGBBlueBrush" Color="#0000D0"/>

    <!-- ボタン用ホバー／プレス用オーバーレイブラシ -->
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#1A000000"/>

    <!-- デバッグコンソール -->
    <SolidColorBrush x:Key="DebugBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DebugForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DebugToolbarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="DebugToolbarBorder" Color="#D0D0D0"/>

    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5E5"/>

    <!-- 暗黙の文字色（テーマに応じた既定の前景色） -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>

    <!-- GroupBox の Fluent スタイル（丸角 8px） -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="true">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Grid.ColumnSpan="4" 
                                Grid.Row="1" 
                                Grid.RowSpan="3" 
                                Background="Transparent"/>
                        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBackground}" Padding="4,0" Margin="0,0,0,-2">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" 
                                           Grid.ColumnSpan="2" 
                                           Grid.Row="2" 
                                           Margin="{TemplateBinding Padding}" 
                                           SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="SavingsForeground" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="Green"/>
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="Blue"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="Red"/>

    <!-- GridViewColumnHeader のダークモード対応スタイル -->
    <Style TargetType="GridViewColumnHeader">
        <Style.Triggers>
            <Trigger Property="GridViewColumnHeader.Role" Value="Floating">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Canvas Name="PART_FloatingHeaderCanvas">
                                <Rectangle Width="{TemplateBinding ActualWidth}" Height="{TemplateBinding ActualHeight}" Fill="#FF000000" Opacity="0.5"/>
                            </Canvas>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="GridViewColumnHeader.Role" Value="Padding">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                            <Border Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="#00FFFFFF"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="0,2"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type GridViewColumnHeader}">
                    <Grid>
                        <Border Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0" CornerRadius="{DynamicResource ControlCornerRadius}">
                            <Border Margin="6,0,0,0" Padding="{TemplateBinding Padding}">
                                <ContentPresenter Name="HeaderContent"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    RecognizesAccessKey="True"
                                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                        </Border>
                        <Canvas>
                            <Thumb Name="PART_HeaderGripper">
                                <FrameworkElement.Style>
                                    <Style TargetType="{x:Type Thumb}">
                                        <Setter Property="Canvas.Right" Value="-9"/>
                                        <Setter Property="Width" Value="18"/>
                                        <Setter Property="Height" Value="{Binding Path=ActualHeight, RelativeSource={RelativeSource Mode=TemplatedParent}}"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Background" Value="#00FFFFFF"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="{x:Type Thumb}">
                                                    <Border Padding="{TemplateBinding Padding}" Background="#00FFFFFF">
                                                        <Rectangle Width="1" HorizontalAlignment="Center" Fill="#00FFFFFF"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </FrameworkElement.Style>
                            </Thumb>
                        </Canvas>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="{DynamicResource ListViewItemBackgroundPointerOver}"/>
                            <Setter TargetName="PART_HeaderGripper" Property="Background" Value="#00FFFFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background" Value="#00FFFFFF"/>
                            <Setter TargetName="PART_HeaderGripper" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="TextElement.Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
