<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- デフォルト（ライト）テーマ色 -->

    <SolidColorBrush x:Key="WindowBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="ControlBackground" Color="White"/>
    <SolidColorBrush x:Key="ControlForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="ControlForegroundDim" Color="#555555"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="BorderBrushLight" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="MenuBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="ToolbarBackground" Color="#F9F9F9"/>
    <SolidColorBrush x:Key="StatusBarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="StatusBarBorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="ListBackground" Color="White"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="HeaderBorderBrush" Color="#D9D9D9"/>
    <SolidColorBrush x:Key="AccentBackground" Color="#E2F0D9"/>
    <SolidColorBrush x:Key="AccentBorderBrush" Color="#A9D08E"/>
    <SolidColorBrush x:Key="AccentForeground" Color="#385723"/>
    <SolidColorBrush x:Key="GearButtonForeground" Color="#888888"/>
    <SolidColorBrush x:Key="GearButtonHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="GearButtonHoverForeground" Color="#333333"/>
    <SolidColorBrush x:Key="GearButtonPressedBackground" Color="#CCE8FF"/>
    <SolidColorBrush x:Key="GearButtonPressedForeground" Color="#0078D4"/>
    <SolidColorBrush x:Key="ToolbarButtonHoverBackground" Color="#E5E5E5"/>
    <SolidColorBrush x:Key="ToolbarButtonPressedBackground" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ButtonBackground" Color="White"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="SettingsBackground" Color="White"/>
    <SolidColorBrush x:Key="SettingsBorderBrush" Color="#DFDFDF"/>
    <SolidColorBrush x:Key="TabBackground" Color="Transparent"/>

    <!-- ドラッグ＆ドロップ時のハイライト色 -->
    <SolidColorBrush x:Key="DragOverBackground" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="DragOverBorderBrush" Color="#0078D4"/>

    <!-- RGBスライダーのラベル用配色（テーマ対応） -->
    <SolidColorBrush x:Key="RGBRedBrush" Color="#C00000"/>
    <SolidColorBrush x:Key="RGBGreenBrush" Color="#008000"/>
    <SolidColorBrush x:Key="RGBBlueBrush" Color="#0000D0"/>

    <!-- ボタン用ホバー／プレス用オーバーレイブラシ -->
    <SolidColorBrush x:Key="ButtonHoverOverlayBrush" Color="#0D000000"/>
    <SolidColorBrush x:Key="ButtonPressedOverlayBrush" Color="#1A000000"/>

    <!-- デバッグコンソール -->
    <SolidColorBrush x:Key="DebugBackground" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="DebugForeground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="DebugToolbarBackground" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="DebugToolbarBorder" Color="#D0D0D0"/>

    <SolidColorBrush x:Key="SeparatorBrush" Color="#E5E5E5"/>

    <!-- 暗黙の文字色（テーマに応じた既定の前景色）とコントロールスタイル（Wpf.Ui ベース） -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="ListView" BasedOn="{StaticResource {x:Type ListView}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
    </Style>
    <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
    </Style>
    <Style TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="ProgressBar" BasedOn="{StaticResource {x:Type ProgressBar}}">
        <Setter Property="Foreground" Value="{DynamicResource AccentBackground}"/>
    </Style>
    <Style TargetType="Slider" BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="Menu" BasedOn="{StaticResource {x:Type Menu}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackground}"/>
    </Style>
    <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
    </Style>
    <Style TargetType="ContextMenu" BasedOn="{StaticResource {x:Type ContextMenu}}">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="StatusBar" BasedOn="{StaticResource {x:Type StatusBar}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource StatusBarBackground}"/>
    </Style>
    <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
        <Setter Property="Background" Value="{DynamicResource ControlBackground}"/>
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="Separator" BasedOn="{StaticResource {x:Type Separator}}">
        <Setter Property="Background" Value="{DynamicResource BorderBrush}"/>
    </Style>
    <Style TargetType="ScrollViewer" BasedOn="{StaticResource {x:Type ScrollViewer}}">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style TargetType="ScrollBar" BasedOn="{StaticResource {x:Type ScrollBar}}">
        <!-- ScrollBar は Wpf.Ui のデフォルトスタイルを適用 -->
    </Style>
    <Style TargetType="GridViewColumnHeader" BasedOn="{StaticResource {x:Type GridViewColumnHeader}}">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HeaderBorderBrush}"/>
    </Style>

    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource ControlForeground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="0,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid SnapsToDevicePixels="true">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="6"/>
                        </Grid.RowDefinitions>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="8" 
                                Grid.ColumnSpan="4" 
                                Grid.Row="1" 
                                Grid.RowSpan="3" 
                                Background="Transparent"/>
                        <Border Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Background="{DynamicResource WindowBackground}" Padding="4,0" Margin="0,0,0,-2">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" 
                                           Grid.ColumnSpan="2" 
                                           Grid.Row="2" 
                                           Margin="{TemplateBinding Padding}" 
                                           SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <SolidColorBrush x:Key="SavingsForeground" Color="#2E7D32"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="Green"/>
    <SolidColorBrush x:Key="StatusProcessingBrush" Color="Blue"/>
    <SolidColorBrush x:Key="StatusErrorBrush" Color="Red"/>
</ResourceDictionary>
