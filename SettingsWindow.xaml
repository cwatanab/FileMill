                                                <ComboBoxItem Content="libx264 (標準 H.264 - 互換性高)" FontSize="12"/>
                                                <ComboBoxItem Content="libx265 (HEVC - 圧縮率大・互換性中)" FontSize="12"/>
                                                <ComboBoxItem Content="libvpx-vp9 (VP9)" FontSize="12"/>
