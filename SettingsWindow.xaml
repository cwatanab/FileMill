                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfKeepInlineImages, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </StackPanel>

