                                    <Grid>
                                        <TextBlock Text="テキスト・構造データの圧縮レベル" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding PdfCompressionLevel}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                    </Grid>
                                    <TextBlock Text="ページ内容（テキスト、描画座標）を可逆圧縮する強さです (9: 最高圧縮)" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                    <Slider Minimum="1" Maximum="9" Value="{Binding PdfCompressionLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="デコードレベル" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfDecodeLevelIndex, Mode=TwoWay}" Height="36">
                                        <ComboBoxItem Content="none - ストリームを圧縮したまま保持 (最速)" FontSize="12"/>
