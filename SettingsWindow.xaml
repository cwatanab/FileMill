                                            <TextBlock Text="未参照オブジェクトを保持する" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="論理的に参照のない独立したオブジェクトを削除せず保護します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfPreserveUnreferencedObjects, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="コンテンツの改行コードを正規化" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="ストリーム内の不要なCR/LFなどの余分な制御文字を整理します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfNormalizeContent, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="コンテンツストリームを結合" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="断片化しているテキスト・描画ストリームを1本に統合します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfCoalesceContents, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="endstream 前に改行を挿入" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="一部の古いPDFリーダーとの互換性のためにブロック末尾を改行します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfNewlineBeforeEndStream, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- PDF 配布・互換性設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfCompatibility}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Web表示用にリニアライズ (Fast Web View)" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="PDFの構造を整理し、ブラウザ等で最初のページから順次ストリーミング読み込み可能にします" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfLinearize, Mode=TwoWay}" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="適合最小バージョン" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfMinVersionIndex, Mode=TwoWay}" Height="36">
                                            <ComboBoxItem Content="指定なし"/>
                                            <ComboBoxItem Content="1.3 (Acrobat 4相当)"/>
                                            <ComboBoxItem Content="1.4 (Acrobat 5相当)"/>
                                            <ComboBoxItem Content="1.5 (Acrobat 6相当)"/>
                                            <ComboBoxItem Content="1.6 (Acrobat 7相当)"/>
                                            <ComboBoxItem Content="1.7 (Acrobat 8相当)"/>
                                            <ComboBoxItem Content="2.0 (ISO 32000-2準拠)"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="強制バージョン設定" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfForceVersionIndex, Mode=TwoWay}" Height="36" ToolTip="特定のPDF互換バージョンを強制します">
                                            <ComboBoxItem Content="指定なし"/>
                                            <ComboBoxItem Content="1.3"/>
                                            <ComboBoxItem Content="1.4"/>
                                            <ComboBoxItem Content="1.5"/>
                                            <ComboBoxItem Content="1.6"/>
                                            <ComboBoxItem Content="1.7"/>
                                            <ComboBoxItem Content="2.0"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- PDF 制限解除設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfRestrictions}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="所有者パスワード制限の解除" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="PDFの閲覧・印刷等のセキュリティ保護を無効化してプレーンなPDFにします" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfDecrypt, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="電子署名および編集制限の解除" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="コピー制限や編集禁止フラグを取り除きます（埋め込まれた電子署名は失われます）" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PdfRemoveRestrictions, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- オプション設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Options}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="表示言語" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" Height="36">
                                            <ComboBoxItem Content="日本語 (Japanese)"/>
                                            <ComboBoxItem Content="English"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="テーマ設定" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" Height="36">
                                            <ComboBoxItem Content="ライトテーマ (Light)"/>
                                            <ComboBoxItem Content="ダークテーマ (Dark)"/>
                                            <ComboBoxItem Content="システム自動判定"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="処理完了通知" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="すべてのファイル変換が終了した際、システム音を鳴らして通知します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding PlaySoundOnComplete, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="クリア時の確認ダイアログ" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="変換リストからすべてのファイルを一括クリアする前に、警告ポップアップを表示します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ConfirmOnClear, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="出力ファイル命名規則" FontSize="13" FontWeight="Bold" Margin="0,0,0,4"/>
                                    <TextBlock Text="元のファイル名の末尾に付加する接尾辞（Suffix）" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,8"/>
                                    <ui:TextBox Text="{Binding FileNameRule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例: _optimized (空欄時は同名ファイルが上書きされます)" Height="36" VerticalContentAlignment="Center" />
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="外部ツール実行ファイル パス設定" FontSize="13" FontWeight="Bold" Margin="0,0,0,10"/>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="oxipng" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding OxipngPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="oxipng.exe の絶対パス" Height="36" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="参照..." Width="70" Height="36" Command="{Binding BrowseToolPathCommand}" CommandParameter="oxipng" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="jpegli" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding CjpegliPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="cjpegli.exe の絶対パス" Height="36" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="参照..." Width="70" Height="36" Command="{Binding BrowseToolPathCommand}" CommandParameter="cjpegli" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ffmpeg" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="ffmpeg.exe の絶対パス" Height="36" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="参照..." Width="70" Height="36" Command="{Binding BrowseToolPathCommand}" CommandParameter="ffmpeg" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="qpdf" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding QpdfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="qpdf.exe の絶対パス" Height="36" VerticalContentAlignment="Center" />
                                        <ui:Button Grid.Column="2" Content="参照..." Width="70" Height="36" Command="{Binding BrowseToolPathCommand}" CommandParameter="qpdf" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- グレースケール化設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Grayscale}">
                            <ui:Card Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="グレースケール化は、画像のカラーチャンネルを輝度値に基づいて統合し、完全な白黒（モノクロ）画像に変換します。この機能に追加の設定オプションはありません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- Exif自動回転設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ExifAutoRotate}">
                            <ui:Card Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="デジカメやスマートフォンで撮影した画像に埋め込まれている「Exifオリエンテーションメタデータ」を解析し、画像本体を物理的に適切な向き（正対方向）に回転して保存します。この機能に追加の設定オプションはありません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- デフォルト -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Default}">
                            <ui:Card Padding="16">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Info24" FontSize="20" Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <TextBlock Text="選択した機能の設定オプションは準備中または追加パラメータを必要としません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>

            <!-- アクションボタン -->
            <Border Grid.Row="2" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Padding="24,16">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <ui:Button Content="{x:Static properties:Loc.ButtonOK}" Appearance="Primary" IsDefault="True" Click="OK_Click" MinWidth="80" Height="36" Margin="0,0,8,0"/>
                    <ui:Button Content="{x:Static properties:Loc.ButtonCancel}" Appearance="Secondary" IsCancel="True" Click="Cancel_Click" MinWidth="80" Height="36"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
