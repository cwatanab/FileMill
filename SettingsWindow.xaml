<ui:FluentWindow x:Class="FileMill.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMill.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:properties="clr-namespace:FileMill.Properties"
        Title="{Binding ModalTitle}"
        Width="520" SizeToContent="Height"
        MinWidth="480" MaxHeight="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringEqualsToVisibilityConverter x:Key="ModalTypeToVis"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Icon="app.ico" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

        <!-- コンテンツ -->
        <Border Grid.Row="0" Background="{DynamicResource ControlBackground}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1" Padding="15,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid>
                    <!-- リサイズ設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Resize}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="幅 (px)" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding ResizeStep.TargetWidth, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="高さ (px)" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding ResizeStep.TargetHeight, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="モード" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ResizeStep.FitModeIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                <ComboBoxItem Content="内包 (Inside)" FontSize="11"/>
                                <ComboBoxItem Content="外接 (Cover)" FontSize="11"/>
                                <ComboBoxItem Content="引き伸ばし (Fill)" FontSize="11"/>
                            </ComboBox>
                        </Grid>
                        <CheckBox Content="拡大を許可する" IsChecked="{Binding ResizeStep.AllowUpscale}" Margin="0,6,0,0" FontSize="12"/>
                    </StackPanel>

                    <!-- フォーマット変換設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Format}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="出力形式" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding FormatStep.TargetFormatIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                <ComboBoxItem Content="JPEG" FontSize="11"/>
                                <ComboBoxItem Content="PNG" FontSize="11"/>
                                <ComboBoxItem Content="WebP" FontSize="11"/>
                                <ComboBoxItem Content="AVIF" FontSize="11"/>
                                <ComboBoxItem Content="TIFF" FontSize="11"/>
                            </ComboBox>
                        </Grid>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="品質 (JPEG/WebP):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="35"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="100" Value="{Binding FormatStep.Quality}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormatStep.Quality}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,4,0,0">
                            <TextBlock Text="圧縮レベル (PNG):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="9" Value="{Binding FormatStep.CompressionLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding FormatStep.CompressionLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- 最適化設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Optimize}">
                        <CheckBox Content="メタデータを削除" IsChecked="{Binding OptimizeStep.StripMetadata}" Margin="0,2" FontSize="12"/>
                        <CheckBox Content="Huffman最適化 (JPEG)" IsChecked="{Binding OptimizeStep.OptimizeCoding}" Margin="0,2" FontSize="12"/>
                        <CheckBox Content="Trellis量子化 (JPEG)" IsChecked="{Binding OptimizeStep.TrellisQuant}" Margin="0,2" FontSize="12"/>
                        <CheckBox Content="ロスレス (WebP/AVIF)" IsChecked="{Binding OptimizeStep.Lossless}" Margin="0,2" FontSize="12"/>
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="圧縮努力 (WebP/AVIF):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="6" Value="{Binding OptimizeStep.ReductionEffort}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding OptimizeStep.ReductionEffort}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>
                        </StackPanel>

                        <!-- 外部ツール -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="外部ツール:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>

                                <!-- oxipng -->
                                <CheckBox x:Name="UseOxipngCheckOpt" Content="PNGロスレス最適化に oxipng を使う"
                                          IsChecked="{Binding UseOxipng, Mode=TwoWay}" Margin="0,2" FontSize="11"/>
                                <StackPanel Margin="0,2,0,6"
                                            Visibility="{Binding IsChecked, ElementName=UseOxipngCheckOpt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="oxipng 最適化レベル:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="6" Value="{Binding OxipngLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OxipngLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>

                                <!-- jpegli -->
                                <CheckBox x:Name="UseJpegliCheckOpt" Content="JPEG高品質エンコードに jpegli を使う"
                                          IsChecked="{Binding UseJpegli, Mode=TwoWay}" Margin="0,2" FontSize="11"
                                          ToolTip="cjpegli による高品質JPEG最適化を有効にします"/>

                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 減色設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Posterize}">
                        <TextBlock Text="ビット深度:" FontSize="12" Margin="0,2"/>
                        <ComboBox SelectedIndex="{Binding PosterizeStep.BitsIndex}" Margin="0,6" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                            <ComboBoxItem Content="8 bit (フルカラー)" FontSize="11"/>
                            <ComboBoxItem Content="7 bit (128階調)" FontSize="11"/>
                            <ComboBoxItem Content="6 bit (64階調)" FontSize="11"/>
                            <ComboBoxItem Content="5 bit (32階調)" FontSize="11"/>
                            <ComboBoxItem Content="4 bit (16階調)" FontSize="11"/>
                            <ComboBoxItem Content="3 bit (8階調)" FontSize="11"/>
                            <ComboBoxItem Content="2 bit (4階調)" FontSize="11"/>
                            <ComboBoxItem Content="1 bit (2階調)" FontSize="11"/>
                        </ComboBox>
                        <TextBlock Text="{Binding PosterizeStep.LevelsPerChannel, StringFormat='階調レベル: {0}階調/ch'}" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- 回転設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Rotate}">
                        <RadioButton Content="すべての画像を対象にする" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" GroupName="RotateTarget" Margin="0,6" FontSize="12"/>
                        <RadioButton Content="横長画像のみ" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Landscape}" GroupName="RotateTarget" Margin="0,6" FontSize="12"/>
                        <RadioButton Content="縦長画像のみ" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Portrait}" GroupName="RotateTarget" Margin="0,6" FontSize="12"/>
                        <ComboBox SelectedIndex="{Binding RotateStep.RotationAngleIndex, Mode=TwoWay}" Margin="0,8,0,0" Width="180" HorizontalAlignment="Left" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                            <ComboBoxItem Content="90度" FontSize="12"/>
                            <ComboBoxItem Content="180度" FontSize="12"/>
                            <ComboBoxItem Content="270度" FontSize="12"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- トリミング設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Crop}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="幅 (px)" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding CropStep.CropWidth, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="高さ (px)" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding CropStep.CropHeight, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                    </StackPanel>

                    <!-- 余白の追加設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Padding}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="余白サイズ (px)" VerticalAlignment="Center" FontSize="12"/>
                            <TextBox Grid.Column="1" Text="{Binding PaddingStep.PaddingSize, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                        <TextBlock Text="背景色 (RGB):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6,0,0"/>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="R" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource RGBRedBrush}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingRed}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingRed}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="G" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource RGBGreenBrush}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingGreen}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingGreen}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="B" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource RGBBlueBrush}"/>
                            <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingBlue}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingBlue}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- アンシャープマスク設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Sharpen}">
                        <TextBlock Text="強さ (Sigma):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0.1" Maximum="5.0" Value="{Binding SharpenStep.SharpenSigma}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding SharpenStep.SharpenSigma, StringFormat={}{0:F1}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- 色調補正設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ColorAdjust}">
                        <TextBlock Text="明るさ:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding ColorAdjustStep.Brightness}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding ColorAdjustStep.Brightness}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                        <TextBlock Text="コントラスト:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="35"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="-100" Maximum="100" Value="{Binding ColorAdjustStep.Contrast}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding ColorAdjustStep.Contrast}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- トーンカーブ設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ToneCurve}">
                        <TextBlock Text="ガンマ補正:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="0.1" Maximum="3.0" Value="{Binding ToneCurveStep.ToneGamma}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding ToneCurveStep.ToneGamma, StringFormat={}{0:F1}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                        </Grid>
                    </StackPanel>

                    <!-- 画像合成設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Composite}">
                        <TextBlock Text="合成画像 (ウォーターマーク) パス:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding CompositeStep.CompositePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            <Button Grid.Column="1" Content="..." Width="32" Height="32" Command="{Binding BrowseCompositeCommand}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Xオフセット:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="1" Text="{Binding CompositeStep.CompositeX, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            <TextBlock Grid.Column="2" Text="Yオフセット:" VerticalAlignment="Center" FontSize="11" Margin="0,0,4,0"/>
                            <TextBox Grid.Column="3" Text="{Binding CompositeStep.CompositeY, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                        </Grid>
                    </StackPanel>

                    <!-- Office 最適化設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=OfficeOptimize}">
                        <CheckBox Content="作成者・メタデータの削除" IsChecked="{Binding StripOfficeMetadata, Mode=TwoWay}" Margin="0,6" FontSize="12" ToolTip="作成者、最終保存者、編集履歴などを削除します。"/>
                        <CheckBox Content="未使用オブジェクトのクリーンアップ" IsChecked="{Binding CleanUnusedObjects, Mode=TwoWay}" Margin="0,6" FontSize="12" ToolTip="Officeファイルを再パックして不要なデータを減らします。"/>

                        <!-- Excel固有 -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Excel固有:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>
                                <CheckBox Content="選択セルをA1に変更する" IsChecked="{Binding ResetCellSelection, Mode=TwoWay}" Margin="0,6" FontSize="12" ToolTip="すべてのシートの選択セルとスクロール位置をA1にリセットします。"/>
                            </StackPanel>
                        </Border>

                        <!-- 埋め込み画像 -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="埋め込み画像:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>
                                <CheckBox Content="文書内の埋め込み画像を圧縮する" IsChecked="{Binding CompressEmbeddedImages, Mode=TwoWay}" Margin="0,6" FontSize="12" ToolTip="WordやPowerPoint内の画像を圧縮し、画像WebP変換がオンならWebP化します。"/>
                                <CheckBox x:Name="SettingsOfficeResizeImagePpiCheck" Content="画像解像度を PPI で制限" IsChecked="{Binding ResizeEmbeddedImagesByPpi, Mode=TwoWay}" Margin="0,6" FontSize="12" ToolTip="Office上の表示サイズから実効PPIを計算し、指定PPIを超える画像だけ縮小します。"/>
                                <StackPanel Margin="20,8,0,0" Visibility="{Binding IsChecked, ElementName=SettingsOfficeResizeImagePpiCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="目標 PPI:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="56"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="72" Maximum="600" Value="{Binding TargetImagePpi}" TickFrequency="10" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TargetImagePpi, StringFormat={}{0} PPI}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="WebPConvertCheck" Content="画像を WebP 形式に変換" IsChecked="{Binding ConvertToWebP, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6" FontSize="12"/>
                                <StackPanel Margin="20,8,0,0" Visibility="{Binding IsChecked, ElementName=WebPConvertCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="WebP品質:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="35"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="10" Maximum="100" Value="{Binding WebPQuality}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding WebPQuality}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                                <CheckBox x:Name="UseOxipngCheck" Content="PNGロスレス最適化に oxipng を使う" IsChecked="{Binding UseOxipng, Mode=TwoWay}" Margin="0,6" FontSize="11"/>
                                <StackPanel Margin="20,0,0,4" Visibility="{Binding IsChecked, ElementName=UseOxipngCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock Text="oxipng 最適化レベル:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="30"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider Minimum="0" Maximum="6" Value="{Binding OxipngLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                        <TextBlock Grid.Column="1" Text="{Binding OxipngLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                                    </Grid>
                                </StackPanel>
                                <CheckBox Content="JPEG高品質エンコードに jpegli を使う" IsChecked="{Binding UseJpegli, Mode=TwoWay}" Margin="0,6" FontSize="11" ToolTip="cjpegli による高品質JPEG最適化を有効にします"/>
                            </StackPanel>
                        </Border>

                        <!-- 埋め込みメディア -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="埋め込みメディア:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>
                                <CheckBox Content="埋め込み動画を圧縮する" IsChecked="{Binding CompressMedia, Mode=TwoWay}" Margin="0,6" FontSize="12"/>
                                <TextBlock Text="ビデオ品質 (CRF):" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="35"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider Minimum="0" Maximum="51" Value="{Binding MediaVideoCrf}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    <TextBlock Grid.Column="1" Text="{Binding MediaVideoCrf}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="映像コーデック:" VerticalAlignment="Center" FontSize="11"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding MediaVideoCodecIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                        <ComboBoxItem Content="libx264 (H.264)" FontSize="11"/>
                                        <ComboBoxItem Content="libx265 (H.265/HEVC)" FontSize="11"/>
                                        <ComboBoxItem Content="libvpx-vp9 (VP9)" FontSize="11"/>
                                        <ComboBoxItem Content="libaom-av1 (AV1)" FontSize="11"/>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="音声コーデック:" VerticalAlignment="Center" FontSize="11"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding MediaAudioCodecIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                        <ComboBoxItem Content="aac (AAC)" FontSize="11"/>
                                        <ComboBoxItem Content="libopus (Opus)" FontSize="11"/>
                                        <ComboBoxItem Content="copy (コピー)" FontSize="11"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Office PDF 変換設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=OfficePdf}">
                        <CheckBox Content="PDF/A 準拠"
                                  IsChecked="{Binding ConvertOfficeToPdfA, Mode=TwoWay}"
                                  IsEnabled="{Binding IsOfficePdfConversionAvailable}"
                                  Margin="0,6"
                                  FontSize="12"
                                  ToolTip="Word と PowerPoint は PDF/A として出力します。Excel は Microsoft Office Interop の制約により PDF/A 指定に対応していません。"/>
                    </StackPanel>

                    <!-- PDF 画像最適化設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfImage}">
                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Text="JPEG品質" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="36"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="1" Maximum="100" Value="{Binding PdfJpegQuality}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding PdfJpegQuality}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小幅" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding PdfMinWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小高さ" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding PdfMinHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小面積" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding PdfMinArea, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            </Grid>

                            <CheckBox Content="インライン画像を保持" IsChecked="{Binding PdfKeepInlineImages, Mode=TwoWay}" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PDF ストリーム圧縮設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfStream}">
                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Text="圧縮レベル" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                            <Grid Margin="0,2,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="1" Maximum="9" Value="{Binding PdfCompressionLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                <TextBlock Grid.Column="1" Text="{Binding PdfCompressionLevel}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="11"/>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="デコード" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfDecodeLevelIndex, Mode=TwoWay}" FontSize="12" Height="32" VerticalContentAlignment="Center" Padding="6,0,24,0">
                                    <ComboBoxItem Content="none"/>
                                    <ComboBoxItem Content="generalized"/>
                                    <ComboBoxItem Content="specialized"/>
                                    <ComboBoxItem Content="all"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox Content="Flateを再圧縮" IsChecked="{Binding PdfRecompressFlate, Mode=TwoWay}" Margin="0,8,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PDF 構造整理設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfStructure}">
                        <StackPanel Margin="0,2,0,0">
                            <CheckBox x:Name="PdfStructureExternalizeInlineImagesCheck" Content="インライン画像を通常画像に変換" IsChecked="{Binding PdfExternalizeInlineImages, Mode=TwoWay}" Margin="0,2" FontSize="11"/>

                            <Grid Margin="20,6,0,0" Visibility="{Binding IsChecked, ElementName=PdfStructureExternalizeInlineImagesCheck, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小バイト" VerticalAlignment="Center" FontSize="11"/>
                                <TextBox Grid.Column="1" Text="{Binding PdfInlineImageMinBytes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="オブジェクト" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfObjectStreamModeIndex, Mode=TwoWay}" FontSize="12" Height="32" VerticalContentAlignment="Center" Padding="6,0,24,0">
                                    <ComboBoxItem Content="preserve"/>
                                    <ComboBoxItem Content="disable"/>
                                    <ComboBoxItem Content="generate"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="未参照リソース" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfRemoveUnreferencedResourcesIndex, Mode=TwoWay}" FontSize="12" Height="32" VerticalContentAlignment="Center" Padding="6,0,24,0">
                                    <ComboBoxItem Content="auto"/>
                                    <ComboBoxItem Content="yes"/>
                                    <ComboBoxItem Content="no"/>
                                </ComboBox>
                            </Grid>

                            <CheckBox Content="未参照オブジェクトを保持" IsChecked="{Binding PdfPreserveUnreferencedObjects, Mode=TwoWay}" Margin="0,8,0,0" FontSize="11"/>
                            <CheckBox Content="コンテンツ改行を正規化" IsChecked="{Binding PdfNormalizeContent, Mode=TwoWay}" Margin="0,6,0,0" FontSize="11"/>
                            <CheckBox Content="コンテンツストリームを結合" IsChecked="{Binding PdfCoalesceContents, Mode=TwoWay}" Margin="0,6,0,0" FontSize="11"/>
                            <CheckBox Content="endstream前に改行を追加" IsChecked="{Binding PdfNewlineBeforeEndStream, Mode=TwoWay}" Margin="0,6,0,0" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- PDF 配布・互換性設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfCompatibility}">
                        <StackPanel Margin="0,2,0,0">
                            <CheckBox Content="Web表示用にリニアライズ" IsChecked="{Binding PdfLinearize, Mode=TwoWay}" Margin="0,2,0,6" FontSize="11"/>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="最小バージョン" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfMinVersionIndex, Mode=TwoWay}" FontSize="12" Height="32" VerticalContentAlignment="Center" Padding="6,0,24,0">
                                    <ComboBoxItem Content="指定なし"/>
                                    <ComboBoxItem Content="1.3"/>
                                    <ComboBoxItem Content="1.4"/>
                                    <ComboBoxItem Content="1.5"/>
                                    <ComboBoxItem Content="1.6"/>
                                    <ComboBoxItem Content="1.7"/>
                                    <ComboBoxItem Content="2.0"/>
                                </ComboBox>
                            </Grid>

                            <Grid Margin="0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="112"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="強制バージョン" VerticalAlignment="Center" FontSize="11"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding PdfForceVersionIndex, Mode=TwoWay}" FontSize="12" Height="32" VerticalContentAlignment="Center" Padding="6,0,24,0" ToolTip="PDF機能との互換性に注意してください">
                                    <ComboBoxItem Content="指定なし"/>
                                    <ComboBoxItem Content="1.3"/>
                                    <ComboBoxItem Content="1.4"/>
                                    <ComboBoxItem Content="1.5"/>
                                    <ComboBoxItem Content="1.6"/>
                                    <ComboBoxItem Content="1.7"/>
                                    <ComboBoxItem Content="2.0"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </StackPanel>

                    <!-- PDF 制限解除設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=PdfRestrictions}">
                        <StackPanel Margin="0,2,0,0">
                            <CheckBox Content="暗号化を解除" IsChecked="{Binding PdfDecrypt, Mode=TwoWay}" Margin="0,2" FontSize="11"/>
                            <CheckBox Content="署名/制限を解除" IsChecked="{Binding PdfRemoveRestrictions, Mode=TwoWay}" Margin="0,6,0,0" FontSize="11" ToolTip="電子署名は無効になります"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- オプション設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Options}">
                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="言語" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding LanguageIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                <ComboBoxItem Content="日本語" FontSize="11"/>
                                <ComboBoxItem Content="English" FontSize="11"/>
                            </ComboBox>
                        </Grid>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,6,0,0"/>

                        <Grid Margin="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="テーマ" VerticalAlignment="Center" FontSize="12"/>
                            <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0,24,0">
                                <ComboBoxItem Content="ライト" FontSize="11"/>
                                <ComboBoxItem Content="ダーク" FontSize="11"/>
                                <ComboBoxItem Content="自動 (Windowsに従う)" FontSize="11"/>
                            </ComboBox>
                        </Grid>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,6,0,0"/>

                        <CheckBox Content="処理完了時に通知音を鳴らす" IsChecked="{Binding PlaySoundOnComplete, Mode=TwoWay}" Margin="0,6" FontSize="12"/>
                        <CheckBox Content="リストを空にするとき確認する" IsChecked="{Binding ConfirmOnClear, Mode=TwoWay}" Margin="0,6" FontSize="12"/>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="出力ファイル名:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,2"/>
                                <TextBlock Text="元のファイル名の末尾に付与する文字列" FontSize="10" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding FileNameRule, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                            </StackPanel>
                        </Border>
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="外部ツール パス:" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,0,0,4"/>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="oxipng" VerticalAlignment="Center" FontSize="11" Width="70"/>
                                    <TextBox Grid.Column="1" Text="{Binding OxipngPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                                    <Button Grid.Column="2" Content="..." Width="32" Height="32" Command="{Binding BrowseToolPathCommand}" CommandParameter="oxipng" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="jpegli" VerticalAlignment="Center" FontSize="11" Width="70"/>
                                    <TextBox Grid.Column="1" Text="{Binding CjpegliPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                                    <Button Grid.Column="2" Content="..." Width="32" Height="32" Command="{Binding BrowseToolPathCommand}" CommandParameter="cjpegli" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ffmpeg" VerticalAlignment="Center" FontSize="11" Width="70"/>
                                    <TextBox Grid.Column="1" Text="{Binding FfmpegPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                                    <Button Grid.Column="2" Content="..." Width="32" Height="32" Command="{Binding BrowseToolPathCommand}" CommandParameter="ffmpeg" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid Margin="0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="qpdf" VerticalAlignment="Center" FontSize="11" Width="70"/>
                                    <TextBox Grid.Column="1" Text="{Binding QpdfPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="32" VerticalContentAlignment="Center" FontSize="12" Padding="6,0" />
                                    <Button Grid.Column="2" Content="..." Width="32" Height="32" Command="{Binding BrowseToolPathCommand}" CommandParameter="qpdf" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- グレースケール化設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Grayscale}">
                        <TextBlock Text="グレースケール化は画像を白黒に変換します。追加の設定項目はありません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                    </StackPanel>

                    <!-- Exif自動回転設定 -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ExifAutoRotate}">
                        <TextBlock Text="画像に埋め込まれたExifの回転情報に基づいて、自動的に画像の向きを補正します。追加の設定項目はありません。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,6"/>
                    </StackPanel>

                    <!-- デフォルト -->
                    <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Default}">
                        <TextBlock Text="この機能の設定項目は準備中です。" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,10"/>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- アクションボタン -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="16,12">
            <Button Content="{x:Static properties:Loc.ButtonOK}" IsDefault="True" Click="OK_Click" MinWidth="80" Width="Auto" Height="32" Margin="0,0,8,0"/>
            <Button Content="{x:Static properties:Loc.ButtonCancel}" IsCancel="True" Click="Cancel_Click" MinWidth="80" Width="Auto" Height="32"/>
        </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
