                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=MediaCompressToggle, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,12" />
                                        <Grid Margin="0,0,0,12">
                                            <Grid>
                                                <TextBlock Text="映像の品質 (CRF)" FontSize="12" Foreground="{DynamicResource ControlForegroundDim}"/>
