<ui:FluentWindow x:Class="FileMill.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:FileMill.Converters"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:properties="clr-namespace:FileMill.Properties"
        Title="{Binding ModalTitle}"
        Width="640" Height="680"
        MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <conv:StringEqualsToVisibilityConverter x:Key="ModalTypeToVis"/>
        <conv:EnumToBooleanConverter x:Key="EnumToBooleanConverter"/>
        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" Icon="app.ico" />

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ヘッダー -->
            <Border Grid.Row="0" Padding="24,16,24,12" BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Settings24" FontSize="24" Foreground="{DynamicResource SystemAccentColorBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding ModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource ControlForeground}"/>
                        <TextBlock Text="パラメータを調整して処理をカスタマイズします" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- コンテンツ -->
            <Border Grid.Row="1" Background="Transparent" Padding="24,16">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
                    <Grid>
                        <!-- リサイズ設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Resize}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="幅 (px)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding ResizeStep.TargetWidth, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例: 1920" Height="36"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="高さ (px)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding ResizeStep.TargetHeight, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="例: 1080" Height="36"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="モード" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ResizeStep.FitModeIndex}" Height="36">
                                            <ComboBoxItem Content="内包 (Inside) - 比率維持で枠内に収める" FontSize="12"/>
                                            <ComboBoxItem Content="外接 (Cover) - 比率維持で枠全体を覆う" FontSize="12"/>
                                            <ComboBoxItem Content="引き伸ばし (Fill) - 比率無視で全体リサイズ" FontSize="12"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="画像の拡大を許可する" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="元の寸法より大きくなるようなリサイズを許可します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ResizeStep.AllowUpscale}" VerticalAlignment="Center"/>
                                </Grid>
                            </ui:Card>
                        </StackPanel>

                        <!-- フォーマット変換設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Format}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="出力形式" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding FormatStep.TargetFormatIndex}" Height="36">
                                        <ComboBoxItem Content="JPEG" FontSize="12"/>
                                        <ComboBoxItem Content="PNG" FontSize="12"/>
                                        <ComboBoxItem Content="WebP" FontSize="12"/>
                                        <ComboBoxItem Content="AVIF" FontSize="12"/>
                                        <ComboBoxItem Content="TIFF" FontSize="12"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid>
                                            <TextBlock Text="画像品質 (JPEG/WebP/AVIF)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FormatStep.Quality, StringFormat={}{0}%}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                        </Grid>
                                        <TextBlock Text="高いほど高画質ですがファイルサイズが大きくなります" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                        <Slider Minimum="0" Maximum="100" Value="{Binding FormatStep.Quality}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="圧縮レベル (PNG)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding FormatStep.CompressionLevel}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                        </Grid>
                                        <TextBlock Text="数値を大きくすると圧縮率が高くなりますが処理に時間がかかります" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                        <Slider Minimum="0" Maximum="9" Value="{Binding FormatStep.CompressionLevel}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 最適化設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Optimize}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="メタデータを削除" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Exifなどの撮影・編集情報を破棄して容量を削減します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OptimizeStep.StripMetadata}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Huffman符号化の最適化 (JPEG)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="ハフマンテーブルを再計算して効率的に圧縮します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OptimizeStep.OptimizeCoding}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Trellis量子化を有効化 (JPEG)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="量子化時の歪みとデータ量のバランスを最適化します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OptimizeStep.TrellisQuant}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="ロスレス圧縮 (WebP/AVIF)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="画質を劣化させずに完全に可逆圧縮を行います" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding OptimizeStep.Lossless}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="圧縮努力レベル (WebP/AVIF)" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding OptimizeStep.ReductionEffort}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                    </Grid>
                                    <TextBlock Text="高い値ほど圧縮率が上がりますがエンコード時間が延びます" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                    <Slider Minimum="0" Maximum="6" Value="{Binding OptimizeStep.ReductionEffort}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="外部ツールによるロスレス最適化" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="oxipng を使用" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="PNGのロスレス圧縮に外部ツール oxipng を利用します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch x:Name="UseOxipngCheckOpt" Grid.Column="1" IsChecked="{Binding UseOxipng, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsChecked, ElementName=UseOxipngCheckOpt, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid>
                                            <TextBlock Text="oxipng 最適化レベル" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding OxipngLevel}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                        </Grid>
                                        <Slider Minimum="0" Maximum="6" Value="{Binding OxipngLevel}" TickFrequency="1" IsSnapToTickEnabled="True" Margin="0,4,0,0"/>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,12" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="jpegli を使用" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="JPEGエンコードに高品質な cjpegli を利用します" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding UseJpegli, Mode=TwoWay}" VerticalAlignment="Center"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 減色設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Posterize}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="ビット深度" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ComboBox Grid.Column="1" SelectedIndex="{Binding PosterizeStep.BitsIndex}" Height="36">
                                            <ComboBoxItem Content="8 bit (フルカラー)" FontSize="12"/>
                                            <ComboBoxItem Content="7 bit (128階調)" FontSize="12"/>
                                            <ComboBoxItem Content="6 bit (64階調)" FontSize="12"/>
                                            <ComboBoxItem Content="5 bit (32階調)" FontSize="12"/>
                                            <ComboBoxItem Content="4 bit (16階調)" FontSize="12"/>
                                            <ComboBoxItem Content="3 bit (8階調)" FontSize="12"/>
                                            <ComboBoxItem Content="2 bit (4階調)" FontSize="12"/>
                                            <ComboBoxItem Content="1 bit (2階調)" FontSize="12"/>
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock Text="{Binding PosterizeStep.LevelsPerChannel, StringFormat='階調レベル: 各チャンネル {0}階調'}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 回転設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Rotate}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="対象画像" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <RadioButton Content="すべての画像を対象にする" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=All}" GroupName="RotateTarget" Margin="0,6"/>
                                    <RadioButton Content="横長画像のみ回転する" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Landscape}" GroupName="RotateTarget" Margin="0,6"/>
                                    <RadioButton Content="縦長画像のみ回転する" IsChecked="{Binding RotateStep.RotateTarget, Converter={StaticResource EnumToBooleanConverter}, ConverterParameter=Portrait}" GroupName="RotateTarget" Margin="0,6"/>
                                </StackPanel>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="回転角度" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding RotateStep.RotationAngleIndex, Mode=TwoWay}" Height="36">
                                        <ComboBoxItem Content="90度 右回転" FontSize="12"/>
                                        <ComboBoxItem Content="180度 回転" FontSize="12"/>
                                        <ComboBoxItem Content="270度 右回転 (90度 左回転)" FontSize="12"/>
                                    </ComboBox>
                                </Grid>
                            </ui:Card>
                        </StackPanel>

                        <!-- トリミング設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Crop}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="幅 (px)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding CropStep.CropWidth, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="トリミング後の幅" Height="36" />
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="高さ (px)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                        <ui:TextBox Grid.Column="1" Text="{Binding CropStep.CropHeight, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="トリミング後の高さ" Height="36" />
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 余白の追加設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Padding}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="余白サイズ (px)" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold"/>
                                    <ui:TextBox Grid.Column="1" Text="{Binding PaddingStep.PaddingSize, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="追加する余白のサイズ" Height="36" />
                                </Grid>
                            </ui:Card>
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <TextBlock Text="余白の背景色 (RGB)" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="R" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RGBRedBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingRed}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingRed}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="G" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RGBGreenBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingGreen}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingGreen}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="24"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="B" VerticalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource RGBBlueBrush}"/>
                                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding PaddingStep.PaddingBlue}" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding PaddingStep.PaddingBlue}" VerticalAlignment="Center" HorizontalAlignment="Right" FontWeight="Bold" FontSize="12"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- アンシャープマスク設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Sharpen}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="適用量 (Sigma)" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding SharpenStep.SharpenSigma, StringFormat={}{0:F1}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                    </Grid>
                                    <TextBlock Text="輪郭強調の強さを調整します (推奨: 0.5〜1.5)" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                    <Slider Minimum="0.1" Maximum="5.0" Value="{Binding SharpenStep.SharpenSigma}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 色調補正設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ColorAdjust}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <Grid>
                                            <TextBlock Text="明るさ (Brightness)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ColorAdjustStep.Brightness}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding ColorAdjustStep.Brightness}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource SeparatorBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,16" />
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="コントラスト (Contrast)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding ColorAdjustStep.Contrast}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                        </Grid>
                                        <Slider Minimum="-100" Maximum="100" Value="{Binding ColorAdjustStep.Contrast}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </StackPanel>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- トーンカーブ設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=ToneCurve}">
                            <ui:Card Padding="16">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="ガンマ補正値" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ToneCurveStep.ToneGamma, StringFormat={}{0:F1}}" HorizontalAlignment="Right" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource SystemAccentColorBrush}"/>
                                    </Grid>
                                    <TextBlock Text="明るさの中間トーン（ガンマ）を調整します (標準: 1.0)" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" Margin="0,2,0,8"/>
                                    <Slider Minimum="0.1" Maximum="3.0" Value="{Binding ToneCurveStep.ToneGamma}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>

                        <!-- 画像合成設定 -->
                        <StackPanel Visibility="{Binding ActiveModalType, Converter={StaticResource ModalTypeToVis}, ConverterParameter=Composite}">
                            <ui:Card Padding="16" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="合成画像パス (ウォーターマーク)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
