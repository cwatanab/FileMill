<UserControl x:Class="FileMill.Views.DebugWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:prop="clr-namespace:FileMill.Properties">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ツールバー -->
        <Border Grid.Row="0" Background="{DynamicResource WindowBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="4,2">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{x:Static prop:Loc.DebugConsole}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource ControlForegroundDim}" VerticalAlignment="Center" Margin="4,0,12,0"/>

                <Button Content="クリア" Click="Clear_Click" Width="50" Height="20" FontSize="10"/>
            </StackPanel>
        </Border>

        <!-- ログ出力 -->
        <TextBox x:Name="LogTextBox" Grid.Row="1"
                 IsReadOnly="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 FontFamily="Consolas"
                 FontSize="11"
                 Background="{DynamicResource DebugBackground}"
                 Foreground="{DynamicResource DebugForeground}"
                 BorderThickness="0"
                 TextChanged="LogTextBox_TextChanged"/>
    </Grid>
</UserControl>
